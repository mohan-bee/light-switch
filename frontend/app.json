{
  "expo": {
    "name": "Light",
    "slug": "light-switch",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.mohanbee.lightswitch",
      "supportsTablet": false,
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Find and control your paired switches on your Wi-Fi network.",
        "NSBonjourServices": [
          "_goswitch._tcp"
        ]
      }
    },
    "android": {
      "package": "com.mohanbee.lightswitch",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-secure-store",
        {
          "faceIDPermission": false
        }
      ],
      "./modules/goswitch-provisioning/app.plugin.js",
      "expo-status-bar"
    ]
  }
}
